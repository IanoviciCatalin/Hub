{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // Worker separat pentru importul automat de evenimente (aprobat pentru producție 25.11.2026,
  // TNTm în mod „review”: evenimentele noi așteaptă aprobarea în admin).
  "name": "unipulse-ingest",
  "main": "ingest/index.mjs",
  "compatibility_date": "2026-10-30",
  "workers_dev": false,
  "preview_urls": false,
  "vars": {
    // Comutatorul global: cu "false" cron-ul nu face nimic.
    "INGEST_ENABLED": "true",
    "INGEST_USER_AGENT": "UniPulseEventImport/1.0 (+https://site-hub-beige.vercel.app/unipulse/)"
  },
  "durable_objects": {
    "bindings": [{ "name": "UNIPULSE_HUB", "class_name": "UniPulseHub", "script_name": "unipulse-api" }]
  },
  // Descoperire la 6 ore; întreținere zilnică la 02:30 UTC.
  "triggers": { "crons": ["0 */6 * * *", "30 2 * * *"] }
}
