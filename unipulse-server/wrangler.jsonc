{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "unipulse-api",
  "main": "server/index.mjs",
  "compatibility_date": "2026-10-30",
  "workers_dev": true,
  "preview_urls": false,
  "vars": {
    // Emailurile conturilor care vad panoul /unipulse/admin/ (separate prin virgula).
    "UNIPULSE_ADMINS": "cata45513@gmail.com",
    // Origini suplimentare acceptate pentru cereri POST (de ex. un domeniu nou).
    "UNIPULSE_ORIGINS": "https://ianovici.dev",
    // Importul automat de evenimente: "true" doar după aprobarea pentru producție.
    // Cu "false", adminul poate rula doar simulări (citesc sursa, nu scriu în catalog).
    "INGEST_ENABLED": "true",
    "INGEST_USER_AGENT": "UniPulseEventImport/1.0 (+https://site-hub-beige.vercel.app/unipulse/)"
  },
  "durable_objects": {
    "bindings": [{ "name": "UNIPULSE_HUB", "class_name": "UniPulseHub" }]
  },
  "migrations": [{ "tag": "unipulse-v1", "new_sqlite_classes": ["UniPulseHub"] }],
  "d1_databases": [
    {
      "database_name": "unipulse",
      "binding": "DB",
      // Se completeaza dupa `npx wrangler d1 create unipulse`.
      "database_id": "6a849a3a-0a5f-44cd-83b1-d77ddb14b2df"
    }
  ]
}
