{
  "name": "unipulse-api",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "setup": "wrangler d1 execute unipulse --local --file schema.sql",
    "dev": "wrangler dev --local --ip 127.0.0.1 --port 8787",
    "db:remote": "wrangler d1 execute unipulse --remote --file schema.sql",
    "deploy": "wrangler deploy",
    "test": "node --test tests/*.test.mjs",
    "dev:ingest": "wrangler dev --local --config wrangler.ingest.jsonc --test-scheduled --port 8788",
    "deploy:ingest": "wrangler deploy --config wrangler.ingest.jsonc"
  },
  "devDependencies": {
    "jsdom": "30.1.3",
    "wrangler": "4.156.2"
  }
}
