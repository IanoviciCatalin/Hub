{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "out",
  "trailingSlash": true,
  "rewrites": [
    {
      "source": "/api/unipulse/:path*",
      "destination": "https://unipulse-api.unipulse-api.workers.dev/api/unipulse/:path*"
    }
  ]
}
