{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "out",
  "redirects": [
    { "source": "/unipulse", "destination": "/unipulse/", "permanent": true },
    { "source": "/unipulse/admin", "destination": "/unipulse/admin/", "permanent": true }
  ],
  "rewrites": [
    {
      "source": "/api/unipulse/:path*",
      "destination": "https://unipulse-api.unipulse-api.workers.dev/api/unipulse/:path*"
    }
  ]
}
